# Copy this to .env and supply your own OpenRouter API key.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
POSTGRES_DB=wovens_bom
POSTGRES_USER=wovens
POSTGRES_PASSWORD=change-this-for-real-deployments
# For production use a separately provisioned application role and set DOCKER_DATABASE_URL.
# URL-encode username/password, and use postgres as the host. Keep POSTGRES_PASSWORD unencoded.
# DOCKER_DATABASE_URL=postgresql+psycopg://wovens:encoded-password@postgres:5432/wovens_bom
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
# In production supply a separate bucket-scoped MinIO identity through environment injection.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
MINIO_BUCKET=tech-packs
# Production AUTH_SECRET must be generated with python -c "import secrets; print(secrets.token_hex(32))".
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TOKEN_HOURS=12
# The first admin, created at start-up (an existing account with this email is promoted to admin and keeps its password).
# Admins then add everyone else on the Users page. Use a strong password and change it after first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator
# Optional: USD per million tokens, so the Usage page can estimate cost for requests with no recorded charge.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# Optional Langfuse tracing (leave blank to disable). Content capture sends prompts/replies; keep false for supplier data.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
# Optional extraction settings
PAGE_DPI=220
MAX_UPLOAD_MB=40
# Set to true to have the VLM review pages with ambiguous fabric/BOM headings.
VISION_PAGE_CLASSIFICATION=true
