# Copy this to .env and supply your own OpenRouter API key.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
POSTGRES_DB=wovens_bom
POSTGRES_USER=wovens
POSTGRES_PASSWORD=change-this-for-real-deployments
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=tech-packs
# Optional extraction settings
PAGE_DPI=220
MAX_UPLOAD_MB=40
# Set to true to have the VLM review pages with ambiguous fabric/BOM headings.
VISION_PAGE_CLASSIFICATION=true
